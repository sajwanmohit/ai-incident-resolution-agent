          "raw": "{\n  \"incidentId\": \"INC-1003\",\n  \"service\": \"notifications\",\n  \"severity\": \"MEDIUM\",\n  \"message\": \"Email delivery is delayed for 12 minutes across multiple regions\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/incidents",
