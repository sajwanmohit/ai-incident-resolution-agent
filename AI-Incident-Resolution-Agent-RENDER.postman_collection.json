          "raw": "{\n  \"incidentId\": \"INC-1004\",\n  \"service\": \"inventory\",\n  \"severity\": \"LOW\",\n  \"message\": \"Inventory cache refresh is a few minutes behind normal SLA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "incidents"
          ]
        }
