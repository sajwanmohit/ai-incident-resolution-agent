{
  "info": {
    "_postman_id": "render-ai-incident-resolution-agent",
    "name": "AI Incident Resolution Agent - Render",
    "description": "Postman collection for the deployed Render app with sample incidents.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ai-incident-resolution-agent.onrender.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create High Severity Incident",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidentId\": \"INC-1001\",\n  \"service\": \"payments\",\n  \"severity\": \"HIGH\",\n  \"message\": \"Payment API timeout while processing card payments\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "incidents"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Critical Incident",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"incidentId\": \"INC-1002\",\n  \"service\": \"orders\",\n  \"severity\": \"CRITICAL\",\n  \"message\": \"Order service is completely unavailable and all requests are failing\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "incidents"
          ]
        }
      },
      "response": []
