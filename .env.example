# Copy this file to .env and fill in your real values.
# Never commit .env.

KAFKA_BOOTSTRAP_SERVERS=incident-kafka-ai-incident-resolution.f.aivencloud.com:24062
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-aiven-kafka-password
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_TOPIC=incident-events
KAFKA_PARTITIONS=2
KAFKA_REPLICATION_FACTOR=2
KAFKA_CONSUMER_GROUP=incident-resolution-group

# Local Aiven CA certificate path. Keep this relative so it works across dev machines.
# Place your downloaded Aiven ca.pem in ./certs/aiven-ca.pem and keep .env local-only.
KAFKA_SSL_CA_LOCATION=./certs/aiven-ca.pem

# Existing app settings
OPENAI_API_KEY=docker-model-runner
OPENAI_BASE_URL=http://localhost:12434/engines/v1
OPENAI_MODEL=docker.io/ai/qwen3:latest
OPENAI_TEMPERATURE=0.2
PORT=8080
